DATABASE_URL="postgresql://USER:PASSWORD@POOLER_HOST/DATABASE?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@DIRECT_HOST/DATABASE?sslmode=require"
JWT_SECRET="replace-with-at-least-32-random-characters"
JWT_SESSION_IDLE_TIMEOUT_SECONDS=3600
PRISMA_TRANSACTION_MAX_WAIT_MS=10000
PRISMA_TRANSACTION_TIMEOUT_MS=30000
USER_TEMPORARY_PASSWORD_TTL_SECONDS=86400
SMTP_HOST="smtp-relay.brevo.com"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER="replace-with-brevo-smtp-login"
SMTP_PASSWORD="replace-with-brevo-smtp-key"
SMTP_FROM_EMAIL="replace-with-verified-sender@example.com"
SMTP_FROM_NAME="Luma Motos"
FRONTEND_URL="http://localhost:3001"
PORT=3000
NODE_ENV="development"
