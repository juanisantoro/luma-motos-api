  organizaciones                                                              organizaciones @relation(fields: [organizacion_id], references: [id], onUpdate: NoAction, map: "acceso_personal_sucursal_organizacion_fk")
  personal                                                                    personal       @relation(fields: [personal_id], references: [id], onUpdate: NoAction)
  sucursales                                                                  sucursales     @relation(fields: [sucursal_id], references: [id], onUpdate: NoAction)
  sucursales_acceso_personal_sucursal_sucursal_id_organizacion_idTosucursales sucursales     @relation("acceso_personal_sucursal_sucursal_id_organizacion_idTosucursales", fields: [sucursal_id, organizacion_id], references: [id, organizacion_id], onDelete: NoAction, onUpdate: NoAction, map: "acceso_sucursal_organizacion_fk")

  @@id([personal_id, sucursal_id])
}

