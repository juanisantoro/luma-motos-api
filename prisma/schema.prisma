  fila_importacion_id        String            @db.Uuid
  bloque_origen              String            @db.VarChar(40)
  nombre_completo            String?           @db.VarChar(180)
  documento_mostrado         String?           @db.VarChar(40)
  documento_normalizado      String?           @db.VarChar(30)
  telefono                   String?           @db.VarChar(40)
  estado_original            String?           @db.VarChar(160)
  comision_referido          Decimal?          @db.Decimal(18, 2)
  comision_referido_original String?
  datos_inferidos            Json              @default("{}")
  creado_en                  DateTime          @default(now()) @db.Timestamptz(6)
  actualizado_en             DateTime          @default(now()) @db.Timestamptz(6)
  organizaciones             organizaciones    @relation(fields: [organizacion_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  sucursales                 sucursales        @relation(fields: [sucursal_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  filas_importacion          filas_importacion @relation(fields: [fila_importacion_id], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@unique([id, organizacion_id], map: "prospectos_id_organizacion_unico")
  @@unique([organizacion_id, fila_importacion_id, bloque_origen], map: "prospectos_fila_bloque_organizacion_unico")
  @@index([sucursal_id, estado_original], map: "prospectos_sucursal_estado_indice")
}

/// This table contains check constraints, composite tenant foreign keys and row level security.
model registros_inventario_importados {
  id                  String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizacion_id     String              @db.Uuid
  sucursal_id         String              @db.Uuid
  fila_importacion_id String              @db.Uuid
  hoja_origen         String              @db.VarChar(20)
  fecha_registro      DateTime?           @db.Date
  descripcion         String?
  vin_mostrado        String?             @db.VarChar(40)
  vin_normalizado     String?             @db.VarChar(32)
  unidad_vehiculo_id  String?             @db.Uuid
  estado_original     String?             @db.VarChar(120)
  importe             Decimal?            @db.Decimal(18, 2)
  costo               Decimal?            @db.Decimal(18, 2)
  datos_inferidos     Json                @default("{}")
  creado_en           DateTime            @default(now()) @db.Timestamptz(6)
  actualizado_en      DateTime            @default(now()) @db.Timestamptz(6)
  organizaciones      organizaciones      @relation(fields: [organizacion_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  sucursales          sucursales          @relation(fields: [sucursal_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  filas_importacion   filas_importacion   @relation(fields: [fila_importacion_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  unidades_vehiculos  unidades_vehiculos? @relation(fields: [unidad_vehiculo_id], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@unique([id, organizacion_id], map: "registros_inventario_importados_id_organizacion_unico")
  @@unique([organizacion_id, fila_importacion_id], map: "registros_inventario_importados_fila_organizacion_unico")
  @@index([sucursal_id, fecha_registro(sort: Desc)], map: "registros_inventario_importados_sucursal_fecha_indice")
}

